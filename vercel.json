{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.eliteonlinehospital.com"
        }
      ],
      "destination": "https://eliteonlinehospital.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|static/|asset-manifest\\.json|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml|sitemap-index\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
